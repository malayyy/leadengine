# Lead Engine - Environment Configuration
# Copy this to .env and fill in your values

# === Database ===
DATABASE_URL=postgresql://leadengine:password@localhost:5432/leadengine
# SQLITE_URL=sqlite:///data/lead_generation.db  # Falls back if DATABASE_URL not set

# === Redis / Celery Broker ===
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# === LinkedIn ===
# Get this from browser devtools: Application > Cookies > li_at
LINKEDIN_LI_AT_COOKIE=your_li_at_cookie_here

# === Auth ===
ADMIN_PASSWORD=leadengine123
JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRY_MINUTES=1440

# === API ===
PUBLIC_API_DOMAIN=api.chopstickintegrations.com
MCP_API_KEY=leadengine-secret-key

# === Proxies ===
PROXY_LIST=http://user:pass@proxy1:port,http://user:pass@proxy2:port

# === Logging ===
LOG_LEVEL=DEBUG

# === SearXNG (deprecated - engines blocked by CAPTCHAs) ===
SEARXNG_URL=http://searxng:8080

# === AWS SQS (optional - falls back to Redis if not set) ===
SQS_URL=
AWS_REGION=us-east-1
